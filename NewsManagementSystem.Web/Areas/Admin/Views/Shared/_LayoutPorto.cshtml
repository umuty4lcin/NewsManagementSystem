<!doctype html>
<html class="fixed">
<head>
    <!-- Basic -->
    <meta charset="UTF-8">
    <title>@ViewData["Title"] - Haber Yönetim Sistemi</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <!-- Web Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700,800|Shadows+Into+Light" rel="stylesheet" type="text/css">

    <!-- Vendor CSS -->
    <link rel="stylesheet" href="~/porto/vendor/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/porto/vendor/font-awesome/css/font-awesome.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/porto/vendor/magnific-popup/magnific-popup.css" />
    <link rel="stylesheet" href="~/porto/vendor/bootstrap-datepicker/css/bootstrap-datepicker3.css" />

    <!-- Theme CSS -->
    <link rel="stylesheet" href="~/porto/stylesheets/theme.css" />

    <!-- Skin CSS -->
    <link rel="stylesheet" href="~/porto/stylesheets/skins/default.css" />

    <!-- Theme Custom CSS -->
    <link rel="stylesheet" href="~/porto/stylesheets/theme-custom.css">

    @await RenderSectionAsync("Styles", required: false)

    <!-- Head Libs -->
    <script src="~/porto/vendor/modernizr/modernizr.js"></script>
</head>
<body>
    <section class="body">

        <!-- start: header -->
        <header class="header">
            <div class="logo-container">
                <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="logo">
                    <span style="color: ##777; font-size: 16px; font-weight: 600;">Haber Yönetim Sistemi</span>
                </a>
                <div class="visible-xs toggle-sidebar-left" data-toggle-class="sidebar-left-opened" data-target="html" data-fire-event="sidebar-left-opened">
                    <i class="fa fa-bars" aria-label="Toggle sidebar"></i>
                </div>
            </div>

            <!-- start: search & user box -->
            <div class="header-right">
                
                <a href="@Url.Action("Index", "Home", new { area = "" })" target="_blank" class="btn btn-sm btn-primary" style="margin-right: 15px; margin-top: 10px;">
                    <i class="fa fa-globe"></i> Web Sitesini Görüntüle
                </a>

                <span class="separator"></span>

                <div id="userbox" class="userbox">
                    <a href="#" data-toggle="dropdown">
                        <figure class="profile-picture">
                            <i class="fa fa-user fa-2x"></i>
                        </figure>
                        <div class="profile-info" data-lock-name="@User.Identity.Name" data-lock-email="@User.Identity.Name">
                            <span class="name">@User.Identity.Name</span>
                            <span class="role">@(User.IsInRole("Admin") ? "Yönetici" : "Editör")</span>
                        </div>

                        <i class="fa custom-caret"></i>
                    </a>

                    <div class="dropdown-menu">
                        <ul class="list-unstyled">
                            <li class="divider"></li>
                            <li>
                                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item" style="border:none; background:none; width:100%; text-align:left; padding: 10px 15px;">
                                        <i class="fa fa-power-off"></i> Çıkış
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- end: search & user box -->
        </header>
        <!-- end: header -->

        <div class="inner-wrapper">
            <!-- start: sidebar -->
            <aside id="sidebar-left" class="sidebar-left">

                <div class="sidebar-header">
                    <div class="sidebar-title">
                        Menü
                    </div>
                    <div class="sidebar-toggle hidden-xs" data-toggle-class="sidebar-left-collapsed" data-target="html" data-fire-event="sidebar-left-toggle">
                        <i class="fa fa-bars" aria-label="Toggle sidebar"></i>
                    </div>
                </div>

                <div class="nano">
                    <div class="nano-content">
                        <nav id="menu" class="nav-main" role="navigation">
                            <ul class="nav nav-main">
                                <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "nav-active" : "")">
                                    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                                        <i class="fa fa-home" aria-hidden="true"></i>
                                        <span>Dashboard</span>
                                    </a>
                                </li>
                                <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "News" ? "nav-active" : "")">
                                    <a href="@Url.Action("Index", "News", new { area = "Admin" })">
                                        <i class="fa fa-newspaper-o" aria-hidden="true"></i>
                                        <span>Haberler</span>
                                    </a>
                                </li>
                                <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "nav-active" : "")">
                                    <a href="@Url.Action("Index", "Categories", new { area = "Admin" })">
                                        <i class="fa fa-folder" aria-hidden="true"></i>
                                        <span>Kategoriler</span>
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "nav-active" : "")">
                                        <a href="@Url.Action("Index", "Users", new { area = "Admin" })">
                                            <i class="fa fa-users" aria-hidden="true"></i>
                                            <span>Kullanıcılar</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>

            </aside>
            <!-- end: sidebar -->

            <section role="main" class="content-body">
                <header class="page-header">
                    <h2>@ViewData["Title"]</h2>
                </header>

                <!-- start: page -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        <strong>Başarılı!</strong> @TempData["Success"]
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        <strong>Hata!</strong> @TempData["Error"]
                    </div>
                }

                @RenderBody()
                <!-- end: page -->
            </section>
        </div>

    </section>

    <!-- Vendor -->
    <script src="~/porto/vendor/jquery/jquery.js"></script>
    <script src="~/porto/vendor/jquery-browser-mobile/jquery.browser.mobile.js"></script>
    <script src="~/porto/vendor/bootstrap/js/bootstrap.js"></script>
    <script src="~/porto/vendor/nanoscroller/nanoscroller.js"></script>
    <script src="~/porto/vendor/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src="~/porto/vendor/magnific-popup/jquery.magnific-popup.js"></script>
    <script src="~/porto/vendor/jquery-placeholder/jquery-placeholder.js"></script>

    <!-- Theme Base, Components and Settings -->
    <script src="~/porto/javascripts/theme.js"></script>

    <!-- Theme Custom -->
    <script src="~/porto/javascripts/theme.custom.js"></script>

    <!-- Theme Initialization Files -->
    <script src="~/porto/javascripts/theme.init.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

