@{
    ViewData["Title"] = "Şifre Sıfırlama Başarılı";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="mb-3">Şifre Sıfırlama Başarılı</h2>
                    <p class="text-muted">
                        Şifreniz başarıyla sıfırlandı. Artık yeni şifrenizle giriş yapabilirsiniz.
                    </p>
                    <a asp-action="Login" class="btn btn-primary mt-3">Giriş Yap</a>
                </div>
            </div>
        </div>
    </div>
</div>

