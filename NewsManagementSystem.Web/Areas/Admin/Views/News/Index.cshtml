@model IEnumerable<News>
@{
    ViewData["Title"] = "Haberler";
}

<div class="row mb-4">
    <div class="col-md-6">
        <h2>Haberler</h2>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa fa-plus"></i> Yeni Haber Ekle
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Resim</th>
                        <th>Başlık</th>
                        <th>Kategori</th>
                        <th>Yazar</th>
                        <th>Görüntülenme</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var news in Model)
                    {
                        <tr>
                            <td>
                                <img src="@news.ImageUrl" alt="@news.Title" style="width: 50px; height: 50px; object-fit: cover;" />
                            </td>
                            <td>@news.Title</td>
                            <td><span class="badge bg-secondary">@news.Category?.Name</span></td>
                            <td>@news.Author</td>
                            <td>@news.ViewCount</td>
                            <td>
                                @if (news.IsPublished)
                                {
                                    <span class="badge bg-success">Yayında</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Taslak</span>
                                }
                            </td>
                            <td>@news.CreatedDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@news.Id" class="btn btn-warning" title="Düzenle">
                                        <i class="fa fa-pencil"></i>
                                    </a>
                                    @if (news.IsPublished)
                                    {
                                        <form asp-action="Unpublish" asp-route-id="@news.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-default" title="Yayından Kaldır">
                                                <i class="fa fa-remove"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Publish" asp-route-id="@news.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-default" title="Yayınla">
                                                <i class="fa fa-check"></i>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Delete" asp-route-id="@news.Id" method="post" class="d-inline" 
                                          onsubmit="return confirm('Bu haberi silmek istediğinizden emin misiniz?');">
                                        <button type="submit" class="btn btn-danger" title="Sil">
                                            <i class="fa fa-trash-o"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

