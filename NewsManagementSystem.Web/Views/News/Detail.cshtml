@model NewsManagementSystem.Core.Entities.News
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <article class="card shadow-sm mb-4">
                <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="max-height: 400px; object-fit: cover;">
                <div class="card-body">
                    <div class="mb-3">
                        <span class="badge bg-primary">@Model.Category?.Name</span>
                        <span class="badge bg-secondary ms-2">
                            <i class="fas fa-eye"></i> @Model.ViewCount Görüntülenme
                        </span>
                    </div>
                    
                    <h1 class="card-title mb-3">@Model.Title</h1>
                    
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                        <div>
                            <small class="text-muted">
                                <i class="fas fa-user"></i> <strong>@Model.Author</strong>
                            </small>
                        </div>
                        <div>
                            <small class="text-muted">
                                <i class="fas fa-calendar"></i> @Model.PublishedDate?.ToString("dd MMMM yyyy")
                            </small>
                        </div>
                    </div>

                    <div class="lead mb-4">
                        @Model.Summary
                    </div>

                    <div class="news-content">
                        @Html.Raw(Model.Content.Replace("\n", "<br />"))
                    </div>
                </div>
            </article>

            <div class="mb-4">
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left"></i> Tüm Haberlere Dön
                </a>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Categories -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-folder"></i> Kategoriler</h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        @foreach (var category in ViewBag.Categories as IEnumerable<NewsManagementSystem.Core.Entities.Category>)
                        {
                            <a href="@Url.Action("Category", "Home", new { id = category.Id })" 
                               class="list-group-item list-group-item-action">
                                @category.Name
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- Latest News -->
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-newspaper"></i> Son Haberler</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var latestNews in ViewBag.LatestNews as IEnumerable<NewsManagementSystem.Core.Entities.News>)
                        {
                            <a href="@Url.Action("Detail", "News", new { id = latestNews.Id })" 
                               class="list-group-item list-group-item-action">
                                <div class="d-flex">
                                    <img src="@latestNews.ImageUrl" alt="@latestNews.Title" 
                                         class="me-3" style="width: 60px; height: 60px; object-fit: cover;">
                                    <div>
                                        <h6 class="mb-1">@latestNews.Title</h6>
                                        <small class="text-muted">
                                            @latestNews.PublishedDate?.ToString("dd.MM.yyyy")
                                        </small>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

